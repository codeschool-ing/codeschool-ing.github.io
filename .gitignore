# bundle.py output: built from index.html + assets/. Meant for emailing or opening from
# disk, not for publishing.
/showcase.html

# Catalogue tooling: dependencies and generated output.
node_modules/

# The content itself is versioned: exercises-<course>.json costs money and review to
# exist. What gets ignored are each round's derivatives — .validated, .failed, .critiqued,
# .rejected and the timestamped copies — which are regenerated by running the pipeline
# again. The pattern tells them apart by the second dot in the name.
tools/*/exercises-*.*.json
